{
    "name": "VTherm Dashboard",
    // Python 3.14 is required by Home Assistant 2026.11
    "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "forwardPorts": [
        8123,
        5198
    ],
    "portsAttributes": {
        "8123": {
            "label": "Home Assistant",
            "onAutoForward": "notify"
        },
        // npm run dev: the browser imports the frontend of the dashboard from it (start-ha.sh --dev-frontend)
        "5198": {
            "label": "Dashboard frontend (Vite)",
            "onAutoForward": "silent"
        }
    },
    "mounts": [
        // The npm dependencies live on volumes of the container, not on the folder of the host: reading their thousands of files through
        // the mount of the host made each test file start in about 16 s. The sources stay on the host.
        "type=volume,source=vtherm-dashboard-node-modules,target=${containerWorkspaceFolder}/node_modules",
        "type=volume,source=vtherm-dashboard-frontend-node-modules,target=${containerWorkspaceFolder}/frontend/node_modules"
    ],
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "containerEnv": {
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-python.pylint",
                "redhat.vscode-yaml",
                "keesschollaart.vscode-home-assistant",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "runem.lit-plugin"
            ],
            "settings": {
                "files.eol": "\n",
                "editor.tabSize": 4,
                "files.trimTrailingWhitespace": true,
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true
                },
                "[typescript]": {
                    "editor.tabSize": 2
                },
                "[yaml]": {
                    "editor.tabSize": 2
                }
            }
        }
    }
}