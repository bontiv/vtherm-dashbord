{
  "name": "vtherm-dashboard-workspace",
  "version": "0.1.0-beta3",
  "license": "Apache-2.0",
  "private": true,
  "description": "Workspace of the Versatile Thermostat dashboard: the dashboard frontend and its plugin SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bontiv/vtherm_dashboard.git"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/sdk",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p docs/examples/tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:js": "node scripts/check-no-js.ts",
    "check:docs": "node scripts/check-docs.ts",
    "docs:sync": "node scripts/sync-doc-examples.ts",
    "docs:reference": "typedoc",
    "check:reference": "node scripts/check-sdk-reference.ts",
    "catalogs:generate": "node scripts/generate-native-catalogs.ts",
    "check:catalogs": "node scripts/generate-native-catalogs.ts --check",
    "check:sdk-package": "node scripts/check-sdk-package.ts",
    "check:python": "bash scripts/check-python.sh",
    "check": "npm run typecheck && npm run lint && npm run check:js && npm run check:docs && npm run check:completeness && npm run check:reference && npm run check:catalogs && npm run check:python",
    "test": "vitest run",
    "test:docs": "vitest run --mode docs frontend/test/docs.test.ts",
    "test:python": "pytest",
    "check:completeness": "node scripts/check-doc-completeness.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.68.3",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
